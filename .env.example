DATABASE_URL=postgres://coldstart:local@127.0.0.1:55432/coldstart
DATABASE_DIRECT_URL=
ANTHROPIC_API_KEY=sk-ant-example
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_EXTRACT_MODEL=
ANTHROPIC_BLOCK_MODEL=
ANTHROPIC_SYNTHESIS_MODEL=
ANTHROPIC_VERIFIER_MODEL=
ANTHROPIC_RESEARCH_PLAN_MODEL=
# Per-stage provider routing. Accepts provider-prefixed model strings
# (e.g. deepseek/deepseek-v4-flash); unprefixed strings are Anthropic models.
# Each falls back to its ANTHROPIC_* counterpart, then ANTHROPIC_MODEL.
# Production extraction: OpenRouter Gemini primary, direct DeepSeek alternate.
# Keep keys in ignored env files or the deployment secret store.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=
LLM_EXTRACT_MODEL=
# Full-profile extraction alternate: this value, LLM_FALLBACK_MODEL, then ANTHROPIC_MODEL.
# Must use a different provider. Set off to disable. Budgets: 45s primary + 90s alternate.
LLM_EXTRACT_FALLBACK_MODEL=
LLM_BLOCK_MODEL=
LLM_VERIFIER_MODEL=
LLM_SYNTHESIS_MODEL=
LLM_RESEARCH_SECTION_MODEL=
LLM_PERSON_READ_MODEL=
LLM_EXPANDED_DESCRIPTION_MODEL=
LLM_RESEARCH_PLAN_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
LLM_OPENAI_COMPAT_TIMEOUT_MS=
X402_PRIVATE_KEY=
STABLEENRICH_BASE_URL=https://stableenrich.dev
STABLEENRICH_EXA_SEARCH_URL=
STABLEENRICH_EXA_SIMILAR_URL=
STABLEENRICH_FIRECRAWL_URL=
STABLEENRICH_ORG_ENRICH_URL=
# Analysis-mode source re-fetch policy on the reuse-existing-extraction branch: full | targeted |
# skip-fresh. Default full (today's unconditional 13-probe fetch); nothing changes until promoted.
ANALYSIS_SOURCE_REFRESH=full
DIRECT_EXA_API_KEY=
DIRECT_EXA_BASE_URL=
EXA_WEBSETS_CONTACTS_ENABLED=false
EMAIL_PATTERN_FALLBACK_ENABLED=true
EXA_WEBSETS_API_KEY=
EXA_WEBSETS_BASE_URL=
# Durable websets polling window (attempts x seconds; defaults 6 x 20s) and the per-credit USD
# rate used for cost telemetry (defaults to the Starter plan rate).
WEBSETS_POLL_ATTEMPTS=
WEBSETS_POLL_INTERVAL_SECONDS=
EXA_WEBSETS_CREDIT_USD=
DIRECT_FIRECRAWL_API_KEY=
DIRECT_PDL_API_KEY=
# Optional GitHub personal access token for the free commit-email reachability harvester
# (5,000 req/hr vs 60 unauthenticated); GITHUB_PAT is also read as a fallback name. Public
# read-only scope only.
GITHUB_TOKEN=
FAST_BASICS_ENABLED=true
# Gates cited person-read synthesis in the async contact-enrichment worker. Defaults to
# enabled; set to false to disable.
PERSON_READS_ENABLED=
# Long-form company description filed by the block-enrichment worker; default on.
EXPANDED_DESCRIPTION_ENABLED=
# How it wins, the Lens crown. The analysis run dispatches the background how-it-wins-read
# function after storing fresh synthesis; false skips the dispatch. Default on in code.
HOW_IT_WINS_ENABLED=
# Required maximum per root job, shared by its one manual retry. USD, at most 10.
HOW_IT_WINS_JOB_BUDGET_USD=5
# Disable new manual retries during rollback; status and saved reads remain available.
HOW_IT_WINS_RETRY_ENABLED=false
# off skips the critic and adjudication passes after the all-80 judge. It is part of the judgment
# cache key and evaluator signature, so flipping it judges fresh and retires an older worker.
HOW_IT_WINS_REFINEMENT=
# Judge model (falls back to LLM_HOW_IT_WINS_MODEL), frozen writer model (falls back to the
# synthesis chain), and the critic (default deepseek/deepseek-v4-pro; must be a different
# provider from the judge). Changing any of these model routes changes the evaluator signature.
LLM_HOW_IT_WINS_JUDGE_MODEL=
LLM_HOW_IT_WINS_MODEL=
LLM_HOW_IT_WINS_EDITOR_MODEL=
# The Jev screen (docs/superpowers/specs/2026-09-22-how-it-wins-layered-screen.md). "shadow" runs
# it beside the judge and records its shortlist on the run trace; unset or anything else is off.
# The key is Cold Start's TypeSafe key and stays server-side.
HOW_IT_WINS_SCREEN=
TYPESAFE_API_KEY=
# Dispatch path for user-facing profile runs (basics, analysis) queued by /api/generate.
# Defaults to inline (in-process, no Inngest dispatcher wait). Set to inngest to restore
# queue dispatch on the next deployment.
GENERATION_DISPATCH=
PUBLIC_GENERATION_ENABLED=false
ALPHA_ACCESS_ENABLED=true
ALPHA_GENERATION_ENABLED=true
ALPHA_SUPPORTED_EXTENSION_VERSIONS=
ALPHA_PROFILE_WORST_CASE_USD=
ALPHA_LENS_WORST_CASE_USD=
ALPHA_INVITE_ORIGIN=http://localhost:3000
CRON_SECRET=
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
CHROME_WEB_STORE_URL=
VITE_COLD_START_API_ORIGIN=http://localhost:3000
CHROME_EXTENSION_ID=local-dev
# Comma-separated extension IDs; when set, replaces CHROME_EXTENSION_ID for identity checks
# (multi-build rollout, e.g. Chrome plus a pinned older build).
ALLOWED_EXTENSION_IDS=
ALLOWED_EXTENSION_ORIGINS=chrome-extension://*,http://localhost:5173
EXTENSION_API_TOKEN=local-extension-token
# Comma-separated bearer tokens; when set, replaces EXTENSION_API_TOKEN as the full accepted
# list (zero-downtime token rotation: old and new token both valid during the swap).
EXTENSION_API_TOKENS=
# AMO JWT credentials for Firefox signing (addons.mozilla.org -> Tools -> Manage API Keys).
# Read by `npm run sign:firefox` via web-ext. Keep the real values in .env.local or
# ~/.secrets.zsh, never in git.
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
INNGEST_EVENT_KEY=local-event-key
INNGEST_SIGNING_KEY=local-signing-key
# Keep background enrichment below the current five-execution Inngest account ceiling.
INNGEST_CARD_ENRICHMENT_CONCURRENCY=2
INNGEST_CONTACT_ENRICHMENT_CONCURRENCY=1
# Same cap, for the background how-it-wins-read function. Unset means no cap.
INNGEST_HOW_IT_WINS_CONCURRENCY=1
